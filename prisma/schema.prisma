// Prisma Schema for Creator The Maker

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum InquiryStatus {
  NEW
  IN_REVIEW
  CONSULTATION_SCHEDULED
  DEPOSIT_RECEIVED
  IN_PRODUCTION
  COMPLETED
  ARCHIVED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Collection {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  tagline     String
  description String
  coverImage  String
  featured    Boolean   @default(false)
  orderIndex  Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  tagline         String
  shortDesc       String
  longDesc        String
  price           Float
  compareAtPrice  Float?
  sku             String           @unique
  inventory       Int              @default(10)
  isAvailable     Boolean          @default(true)
  isFeatured      Boolean          @default(false)
  isNewRelease    Boolean          @default(false)
  capacity        String
  dimensions      String
  material        String
  finish          String
  weight          String
  warranty        String
  collectionId    String
  collection      Collection       @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  images          ProductImage[]
  variants        ProductVariant[]
  reviews         Review[]
  orderItems      OrderItem[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  alt       String
  order     Int      @default(0)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model ProductVariant {
  id             String      @id @default(cuid())
  name           String      // e.g. "Matte Black - RGB Lighting"
  sku            String      @unique
  finish         String      // "Matte Black", "Brushed Obsidian", "Raw Silver"
  lighting       String      // "RGB Ambient", "3000K Warm White", "5000K Pure Studio"
  configuration  String      // "Standard", "Pro Display", "Architectural"
  priceOffset    Float       @default(0.0)
  inventory      Int         @default(5)
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  createdAt      DateTime    @default(now())
}

model Customer {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String?
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  status          OrderStatus @default(PENDING)
  totalAmount     Float
  subtotal        Float
  taxAmount       Float       @default(0.0)
  shippingAmount   Float       @default(0.0)
  currency        String      @default("USD")
  stripeSessionId String?
  shippingAddress Json
  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id        String          @id @default(cuid())
  quantity  Int             @default(1)
  unitPrice Float
  total     Float
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
}

model BespokeInquiry {
  id             String         @id @default(cuid())
  referenceCode  String         @unique
  status         InquiryStatus  @default(NEW)
  name           String
  email          String
  phone          String
  whatsappNumber String?
  sneakerCount   String         // "1-10", "10-25", "25-50", "50-100", "100+"
  spaceWidth     String?
  spaceHeight    String?
  spaceDepth     String?
  style          String?
  finish         String?
  lighting       String?
  requirements   String
  images         BespokeImage[]
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model BespokeImage {
  id        String         @id @default(cuid())
  url       String
  inquiryId String
  inquiry   BespokeInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
}

model GalleryProject {
  id             String         @id @default(cuid())
  title          String
  slug           String         @unique
  category       String         // "Sneaker Rooms", "Trunks", "Wall Storage", "Custom Projects"
  location       String
  collectionSize String
  solution       String
  year           String         @default("2026")
  featured       Boolean        @default(false)
  coverImage     String
  images         GalleryImage[]
  createdAt      DateTime       @default(now())
}

model GalleryImage {
  id        String         @id @default(cuid())
  url       String
  caption   String?
  order     Int            @default(0)
  projectId String
  project   GalleryProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  rating    Int      @default(5)
  author    String
  content   String
  location  String?
  verified  Boolean  @default(true)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
